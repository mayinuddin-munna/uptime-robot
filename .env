# Uptime Robot configuration template
# Copy this to .env and fill in values before running monitor or dashboard.

# Files
SITES_FILE=sites.json
STATE_FILE=state.json
HISTORY_FILE=history.json
LOG_FILE=uptime.log

# Monitoring loop
CHECK_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
RETRY_COUNT=2
RETRY_BACKOFF_SECONDS=2.0
LATENCY_ALERT_COOLDOWN_MINUTES=60
HISTORY_RETENTION_DAYS=30
CRASH_RETRY_DELAY_SECONDS=30
MAX_WORKERS=6

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_REFRESH_SECONDS=30

# SMTP / Alerts (example for Gmail SMTP)
# For Gmail you may need an App Password and enable 'Less secure apps' alternatives.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_username@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
ALERT_FROM_EMAIL=alerts@example.com
ALERT_TO_EMAILS=ops@example.com
